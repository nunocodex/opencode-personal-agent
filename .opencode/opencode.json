{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "default_agent": "build",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@asidorenko/openslimedit"
  ],
  "agent": {
    "plan": {
      "description": "Designs implementation plans from specifications. Read-only, never modifies code.",
      "mode": "primary",
      "model": "opencode-go/glm-5.1",
      "color": "#2196F3",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "skill": {
          "*": "deny",
          "writing-plans": "allow"
        }
      }
    },
    "build": {
      "description": "Implements code, runs tests, follows plans with TDD and verification.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "color": "#4CAF50",
      "permission": {
        "skill": {
          "*": "deny",
          "test-driven-development": "allow",
          "verification-before-completion": "allow",
          "executing-plans": "allow"
        }
      }
    },
    "debug": {
      "description": "Investigates root cause of bugs using a systematic 4-phase method. No fix without diagnosis.",
      "mode": "primary",
      "model": "opencode-go/glm-5.1",
      "color": "#FF5722",
      "permission": {
        "edit": "ask",
        "skill": {
          "*": "deny",
          "systematic-debugging": "allow"
        }
      }
    },
    "review": {
      "description": "Reviews code for bugs, security issues, and best practices. Read-only.",
      "mode": "primary",
      "model": "opencode-go/glm-5.1",
      "temperature": 0.1,
      "color": "#9C27B0",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "skill": {
          "*": "deny",
          "requesting-code-review": "allow"
        }
      }
    },
    "docs": {
      "description": "Writes and maintains project documentation, docstrings, README, and API docs.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-pro",
      "temperature": 0.2,
      "color": "#607D8B",
      "permission": {
        "edit": "allow",
        "bash": "deny"
      }
    },
    "file-parser": {
      "description": "Analyzes images, documents, and media files. Read-only: extracts text, describes content, summarizes documents. No code execution or file modification.",
      "mode": "primary",
      "model": "opencode-go/kimi-k2.6",
      "temperature": 0.2,
      "color": "#FF9800",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "skill": {
          "*": "deny"
        }
      }
    },
    "explore": {
      "description": "Fast agent specialized for exploring codebases. Quickly finds files by patterns, searches code for keywords, and answers questions about codebase structure.",
      "model": "opencode-go/deepseek-v4-flash",
      "color": "#00BCD4",
      "permission": {
        "edit": "deny",
        "bash": "ask",
        "skill": {
          "*": "deny"
        }
      }
    },
    "general": {
      "description": "General-purpose agent for researching complex questions and executing multi-step tasks.",
      "model": "opencode-go/deepseek-v4-flash",
      "color": "#795548",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "skill": {
          "*": "allow"
        }
      }
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  }
}