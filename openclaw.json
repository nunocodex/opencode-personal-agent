{
  "gateway": {
    "port": 18789,
    "mode": "local"
  },
  "commands": {
    "ownerAllowFrom": ["telegram:${TELEGRAM_OWNER_ID}"]
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "deepseek/deepseek-v4-flash",
        "fallbacks": [
          "google/gemini-3-flash-preview"
        ]
      },
      "imageModel": {
        "primary": "google/gemini-3-flash-preview"
      }
    }
  },
  "channels": {
    "telegram": {
      "botToken": "${TELEGRAM_BOT_TOKEN}"
    }
  }
}
