{
  "name": "telegram-ai-assistant",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n serve,bot,dash -c blue,green,yellow \"node scripts/serve.mjs\" \"tsx watch src/main.ts\" \"vite dev --config src/dashboard/client/vite.config.ts\"",
    "dev:dash": "vite dev --config src/dashboard/client/vite.config.ts",
    "build": "tsc",
    "build:dash": "vite build --config src/dashboard/client/vite.config.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.15.5",
    "@xenova/transformers": "^2.17.2",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "grammy": "^1.34.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^9.2.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^7.3.3",
    "vitest": "^3.0.7",
    "vue": "^3.5.34"
  }
}
