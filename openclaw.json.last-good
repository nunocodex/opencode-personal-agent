{
  "gateway": {
    "port": 18789,
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "openclaw-local-dev"
    }
  },
  "commands": {
    "ownerAllowFrom": [
      "telegram:${TELEGRAM_OWNER_ID}"
    ]
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "deepseek/deepseek-v4-flash",
        "fallbacks": [
          "google/gemini-3-flash-preview"
        ]
      },
      "imageModel": {
        "primary": "google/gemini-3-flash-preview"
      }
    }
  },
  "channels": {
    "telegram": {
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "open",
      "allowFrom": [
        "*"
      ]
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.5.18",
    "lastTouchedAt": "2026-05-19T01:24:49.489Z"
  }
}
